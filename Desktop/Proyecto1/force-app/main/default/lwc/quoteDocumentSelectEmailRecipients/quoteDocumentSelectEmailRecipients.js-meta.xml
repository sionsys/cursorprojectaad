<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <description>Component for quote document flow which enables selecting recipients of email who will receive generated quote document</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
        <property name="recordId" label="Quote ID" type="String" role="inputOnly" />
        <property name="accountId" label="Account ID" type="String" role="inputOnly" />
        <property name="userSelectedEmailAddresses" label="User Selected Email Addresses" type="String" role="outputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>